rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             (request.auth.uid == 'QEm0DSIzylNQIHpQAZlgtWQkYYE3' ||
              request.auth.token.role in ['admin', 'superadmin']);
    }

    function isValidImageFile() {
      // Allow reasonably large, high‑resolution images (e.g. direct phone camera photos)
      // while still protecting against overly large uploads.
      return request.resource.size < 15 * 1024 * 1024 && // 15MB max
             request.resource.contentType.matches('image/.*');
    }

    function isValidVideoFile() {
      return request.resource.size < 100 * 1024 * 1024 && // 100MB max
             request.resource.contentType.matches('video/.*');
    }

    // ====================
    // USER PRODUCT UPLOADS (All product uploads, pending or approved)
    // ====================
    // Users can upload their own product images/videos, admins can manage all
    // Public read for approved products, authenticated read for pending
    match /products/{userId}/{imageId} {
      allow read: if true; // Public read for all product images (approved products need public access)
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidImageFile();
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    match /products/{userId}/videos/{videoId} {
      allow read: if true; // Public read for all product videos
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidVideoFile();
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ====================
    // USER COLLECTIONS (Private)
    // ====================
    // Users manage their own collection, admins have oversight
    match /collections/{userId}/{imageId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidImageFile();
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ====================
    // USER AVATARS
    // ====================
    // Users can upload their own avatar, anyone authenticated can view
    match /avatars/{userId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidImageFile();
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ====================
    // TEMPORARY UPLOADS
    // ====================
    // Short-term storage for user uploads before processing
    match /temp/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && isOwner(userId) &&
                   (isValidImageFile() || isValidVideoFile());
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // ====================
    // ADMIN-ONLY AREAS
    // ====================
    // Site assets and seed data - admin exclusive
    match /site-assets/{allPaths=**} {
      allow read: if true; // Public read for logos, banners, etc.
      allow write, delete: if isAdmin() && isValidImageFile();
    }

    match /products/seed/{allPaths=**} {
      allow read: if true; // Public read
      allow write, delete: if isAuthenticated() &&
                           (request.auth.uid == 'QEm0DSIzylNQIHpQAZlgtWQkYYE3' || isAdmin());
    }
  }
}
